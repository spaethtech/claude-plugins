#!/usr/bin/env bash
set -euo pipefail

# claude-remote — Manage per-project Claude Code remote-control tmux sessions

readonly VERSION="1.0.0"

# Derive a tmux session name from a project directory.
# Uses the git remote origin if available, otherwise the directory basename.
session_name_for() {
  local dir="${1:-.}"
  dir="$(cd "$dir" && pwd)"

  local name
  if git -C "$dir" rev-parse --is-inside-work-tree &>/dev/null; then
    # Try remote origin URL first (e.g. "org/repo")
    local remote
    remote="$(git -C "$dir" remote get-url origin 2>/dev/null || true)"
    if [[ -n "$remote" ]]; then
      # Strip protocol, host, .git suffix → "org/repo" or just "repo"
      name="${remote##*:}"
      name="${name##*/}"
      name="${name%.git}"
    fi
  fi

  # Fall back to directory basename
  if [[ -z "${name:-}" ]]; then
    name="$(basename "$dir")"
  fi

  # tmux session names: replace dots/slashes with dashes
  name="${name//[.\/]/-}"
  echo "claude/${name}"
}

# Check if a tmux session exists
session_exists() {
  tmux has-session -t "=$1" 2>/dev/null
}

# Get the project directory for the current context
project_dir() {
  if git rev-parse --show-toplevel &>/dev/null; then
    git rev-parse --show-toplevel
  else
    pwd
  fi
}

cmd_start() {
  local dir
  dir="$(project_dir)"
  local session
  session="$(session_name_for "$dir")"

  if session_exists "$session"; then
    echo "Session '$session' is already running."
    echo "Use 'claude-remote attach' to connect, or 'claude-remote restart' to restart."
    return 1
  fi

  echo "Starting Claude Code remote-control for: $dir"
  echo "tmux session: $session"

  tmux new-session -d -s "$session" -c "$dir" "claude remote-control --continue"

  echo "Session started. Connect via claude.ai or run 'claude-remote attach'."
}

cmd_stop() {
  local dir
  dir="$(project_dir)"
  local session
  session="$(session_name_for "$dir")"

  if ! session_exists "$session"; then
    echo "No session '$session' found."
    return 1
  fi

  echo "Stopping session '$session'..."

  # Send Ctrl-C to gracefully stop claude, wait briefly, then kill
  tmux send-keys -t "=$session" C-c 2>/dev/null || true
  sleep 2

  if session_exists "$session"; then
    tmux kill-session -t "=$session" 2>/dev/null || true
  fi

  echo "Session stopped."
}

cmd_restart() {
  local dir
  dir="$(project_dir)"
  local session
  session="$(session_name_for "$dir")"

  if session_exists "$session"; then
    echo "Stopping existing session '$session'..."
    cmd_stop
    sleep 1
  fi

  cmd_start
}

cmd_status() {
  local dir
  dir="$(project_dir)"
  local session
  session="$(session_name_for "$dir")"

  if session_exists "$session"; then
    echo "Session '$session': running"
    tmux list-panes -t "=$session" -F "  pane: #{pane_id}  pid: #{pane_pid}  alive: #{pane_alive}" 2>/dev/null
  else
    echo "Session '$session': not running"
  fi
}

cmd_attach() {
  local dir
  dir="$(project_dir)"
  local session
  session="$(session_name_for "$dir")"

  if ! session_exists "$session"; then
    echo "No session '$session' found. Run 'claude-remote start' first."
    return 1
  fi

  tmux attach-session -t "=$session"
}

cmd_list() {
  local sessions
  sessions="$(tmux list-sessions -F '#{session_name}' 2>/dev/null | grep '^claude/' || true)"

  if [[ -z "$sessions" ]]; then
    echo "No claude-remote sessions running."
    return 0
  fi

  echo "Running claude-remote sessions:"
  echo ""
  while IFS= read -r session; do
    local dir
    dir="$(tmux display-message -t "=$session" -p '#{pane_current_path}' 2>/dev/null || echo 'unknown')"
    echo "  $session  →  $dir"
  done <<< "$sessions"
}

# Get the absolute path to this script (for cron entries)
self_path() {
  local script_dir
  script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  echo "${script_dir}/$(basename "${BASH_SOURCE[0]}")"
}

# Build the cron command for a project directory
cron_command_for() {
  local dir="$1"
  local session
  session="$(session_name_for "$dir")"
  echo "@reboot cd ${dir} && $(self_path) start  # claude-remote:${session}"
}

# Cron tag used to identify our entries
cron_tag_for() {
  local dir="$1"
  local session
  session="$(session_name_for "$dir")"
  echo "claude-remote:${session}"
}

cmd_enable() {
  local dir
  dir="$(project_dir)"
  local tag
  tag="$(cron_tag_for "$dir")"

  # Check if already enabled
  if crontab -l 2>/dev/null | grep -qF "$tag"; then
    echo "Already enabled for $(session_name_for "$dir")."
    return 0
  fi

  local entry
  entry="$(cron_command_for "$dir")"

  # Append to existing crontab
  (crontab -l 2>/dev/null || true; echo "$entry") | crontab -

  echo "Enabled auto-start on boot for: $(session_name_for "$dir")"
  echo "  project: $dir"
  echo "  cron entry: $entry"
}

cmd_disable() {
  local dir
  dir="$(project_dir)"
  local tag
  tag="$(cron_tag_for "$dir")"

  if ! crontab -l 2>/dev/null | grep -qF "$tag"; then
    echo "Not enabled for $(session_name_for "$dir")."
    return 0
  fi

  # Remove matching line from crontab
  crontab -l 2>/dev/null | grep -vF "$tag" | crontab -

  echo "Disabled auto-start on boot for: $(session_name_for "$dir")"
}

cmd_update() {
  echo "Updating Claude Code..."
  claude update

  echo ""
  read -rp "Restart all running sessions? [y/N] " answer
  if [[ "$answer" =~ ^[Yy]$ ]]; then
    local sessions
    sessions="$(tmux list-sessions -F '#{session_name}' 2>/dev/null | grep '^claude/' || true)"

    if [[ -z "$sessions" ]]; then
      echo "No sessions to restart."
      return 0
    fi

    while IFS= read -r session; do
      local dir
      dir="$(tmux display-message -t "=$session" -p '#{pane_current_path}' 2>/dev/null || echo '')"
      if [[ -n "$dir" && -d "$dir" ]]; then
        echo "Restarting $session ($dir)..."
        tmux send-keys -t "=$session" C-c 2>/dev/null || true
        sleep 2
        if session_exists "$session"; then
          tmux kill-session -t "=$session" 2>/dev/null || true
        fi
        sleep 1
        tmux new-session -d -s "$session" -c "$dir" "claude remote-control --continue"
        echo "  Restarted."
      fi
    done <<< "$sessions"
  fi
}

cmd_help() {
  cat <<HELP
claude-remote v${VERSION} — Per-project Claude Code remote-control sessions

Usage: claude-remote <command> [options]

Commands:
  start       Start a remote-control session for the current project
  stop        Stop the session for the current project
  restart     Stop and restart (resumes Claude conversation)
  status      Check if a session is running for the current project
  attach      Attach to the tmux session to inspect it
  list        List all running claude-remote sessions
  enable      Add @reboot cron entry to auto-start on boot
  disable     Remove the @reboot cron entry
  update      Update Claude Code and optionally restart sessions
  help        Show this help message

Each project gets its own tmux session named "claude/<project>", derived
from the git remote or directory name. Sessions persist across detach and
can be resumed with --continue to maintain conversation context.
HELP
}

# Main dispatch
case "${1:-help}" in
  start)   cmd_start ;;
  stop)    cmd_stop ;;
  restart) cmd_restart ;;
  status)  cmd_status ;;
  attach)  cmd_attach ;;
  list)    cmd_list ;;
  enable)  cmd_enable ;;
  disable) cmd_disable ;;
  update)  cmd_update ;;
  help|--help|-h) cmd_help ;;
  *)
    echo "Unknown command: $1"
    echo "Run 'claude-remote help' for usage."
    exit 1
    ;;
esac
